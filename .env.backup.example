# Copie este archivo como .env.backup y manténgalo fuera de Git.
# Todas las rutas deben ser absolutas y privadas.

DATABASE_URL=
DATABASE_BACKUP_DIR=
EXTERNAL_BACKUP_DIR=
EXTERNAL_BACKUP_MOUNT=
BACKUP_PASSPHRASE_FILE=

# Verificación de antigüedad de la última copia externa.
BACKUP_MAX_AGE_DAYS=35

# Registro local opcional de alertas operativas.
OPERATIONAL_ALERT_LOG=
OPERATIONAL_ALERT_DISABLE_DESKTOP=0

# URL pública utilizada por el smoke de producción.
PRODUCTION_URL=https://laboratorio-prestamos.vercel.app
