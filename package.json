    "check:production": "node scripts/check-production-health.mjs",
    "backup:database": "node scripts/backup-database.mjs",
    "backup:external": "node scripts/export-backup-encrypted.mjs",
    "backup:setup-encryption": "node scripts/setup-backup-encryption.mjs",
    "backup:verify": "node scripts/verify-database-backup.mjs",
    "backup:verify-encrypted": "node scripts/verify-encrypted-backup.mjs",
