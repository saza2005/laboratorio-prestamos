{
  "name": "laboratorio-prestamos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/public tests/auth",
    "test:e2e:accessibility": "playwright test tests/public/accessibility.spec.ts",
    "test:e2e:csp": "playwright test tests/public/csp.spec.ts",
    "test:e2e:roles": "playwright test tests/roles",
