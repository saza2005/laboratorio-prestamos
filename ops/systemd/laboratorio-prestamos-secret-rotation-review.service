[Unit]
Description=Recordatorio trimestral de revisión de secretos de laboratorio-prestamos
Documentation=file://%h/Proyectos/laboratorio-prestamos/docs/ROTACION_SECRETOS.md

[Service]
Type=oneshot
WorkingDirectory=%h/Proyectos/laboratorio-prestamos
Environment=PATH=%h/.nvm/versions/node/v24.14.1/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/usr/bin/env node %h/Proyectos/laboratorio-prestamos/scripts/record-secret-rotation-reminder.mjs
NoNewPrivileges=true
PrivateTmp=true
