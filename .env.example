# Copie este archivo como .env.local y complete los valores fuera de Git.
# Nunca coloque aquí valores reales ni convierta variables privadas en NEXT_PUBLIC_*.

# Configuración pública necesaria para los clientes Supabase del navegador y servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen canónico sin barra final. En local normalmente: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notificaciones opcionales. Si RESEND_API_KEY está vacío, no se envían correos.
RESEND_API_KEY=
EMAIL_FROM=
